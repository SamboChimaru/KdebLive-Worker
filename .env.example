# =================================================================
# 24/7 Live Stream Worker Node - Configuration (Phase 2)
# =================================================================

# Network port and host binding
WORKER_PORT=8000
WORKER_HOST=0.0.0.0

# Secret API Key for authentication (must match Controller's /addserver key)
WORKER_API_KEY=default_secret_key

# 24/7 Infinite loop streaming default (true / false)
DEFAULT_LOOP=true

# Storage disk minimum free percent threshold (auto-cleans oldest videos if reached)
DISK_MIN_FREE_PERCENT=15.0
